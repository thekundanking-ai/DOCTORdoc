# Backend
APP_NAME=DoctorDoc
DEBUG=false
DATABASE_URL=postgresql+psycopg2://doctordoc:doctordoc@localhost:5432/doctordoc
FRONTEND_ORIGIN=http://localhost:5173

# Security
# Generate a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`.
# Required unless DEBUG=true. Never commit real values.
SECRET_KEY=
# Set true when serving behind TLS in production.
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Audio upload (Phase 4)
MAX_AUDIO_BYTES=52428800
AUDIO_RETENTION_DAYS=7
AUDIO_MAX_DURATION_SECONDS=3600

# Gnani AI STT (Phase 5) - backend only, never in frontend env vars
GNANI_API_KEY=
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_LANGUAGE_CODE=indic-auto
GNANI_STT_FORMAT=transcribe
GNANI_POLL_INTERVAL_SECONDS=15
GNANI_POLL_MAX_INTERVAL_SECONDS=30

# Inception Mercury 3 (Phase 6) - backend only, never in frontend env vars
MERCURY_API_KEY=
MERCURY_BASE_URL=https://api.inceptionlabs.ai
MERCURY_MODEL=mercury-3
MERCURY_TIMEOUT_SECONDS=60

# Delivery (Phase 7 prep) - backend only, never exposed to the frontend.
# SMTP is selected when SMTP_HOST + SMTP_USERNAME + SMTP_PASSWORD are set.
# Leave these unset to use the mock provider (dev/tests only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=true
# Account registration + email verification (auth)
# ------------------------------------------------
# Registration requires a mail transport to send the verification email. In
# development (DEBUG=true) with SMTP left unset, the verification token is
# returned in the /auth/register response (dev-only). In production (DEBUG=false)
# SMTP must be configured or registration is refused with 503.
#
# In-process rate limits (requests per minute, keyed by client IP).
RATE_LIMIT_LOGIN=30
RATE_LIMIT_REGISTER=10
RATE_LIMIT_WINDOW_SECONDS=60
#
# Per-clinic Gmail sender (Phase 7)
# ----------------------------------
# The clinic owner's verified Gmail is stored on clinic.sender_email and used as
# the From/sender for that clinic's report deliveries when it matches the SMTP
# account below. Registration itself does NOT grant Gmail SMTP access: the App
# Password is separate config, never the account login password, and must be
# kept in backend-only env (SMTP_PASSWORD). Never put it in React/API/logs.


